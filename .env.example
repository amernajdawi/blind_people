# Optional lock for the browser and for glasses. Leave empty for a local demo.
# Glasses send: Authorization: Bearer <this password>
# SEEINGAEYE_APP_PASSWORD=
# Cap expensive API calls per IP per minute. 0 turns the cap off.
# SEEINGAEYE_RATE_LIMIT_PER_MIN=40

# Ollama Cloud — create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=

OLLAMA_HOST=https://ollama.com

# Cloud model (requires access on your Ollama account). Alternatives: gemma4:e4b, gemma4:e2b
# https://ollama.com/library/gemma4
OLLAMA_MODEL=gemma4:31b-cloud

# Optional: full custom system prompt (overrides built-in strong default)
# OLLAMA_SYSTEM_PROMPT=

# Text chat: longer answers than vision (vision uses OLLAMA_MAX_TOKENS)
# OLLAMA_CHAT_MAX_TOKENS=1536
# OLLAMA_CHAT_TEMPERATURE=0.78

# Set to true for Gemma “thinking” mode (often smarter, slower). See https://ollama.com/library/gemma4
# OLLAMA_THINKING=false

# Shorter answers = faster (vision + cloud latency dominates; this caps decode length)
OLLAMA_MAX_TOKENS=320
# Or set explicitly: OLLAMA_NUM_PREDICT=256

# Smaller frame = faster upload + vision encoding (try 512 on slow links)
OLLAMA_IMAGE_MAX_SIDE=640
OLLAMA_JPEG_QUALITY=72

# Slightly lower temperature can reduce rambling (optional)
# OLLAMA_TEMPERATURE=0.85
# OLLAMA_TOP_P=0.9
# OLLAMA_TOP_K=64

# --- LangChain text agent (tools: web search, GPS weather, GPS place) ---
# When true, /api/llm/chat uses LangChain create_agent + ChatOllama instead of raw /api/chat streaming.
# Blind-assist Modality A benefits when USE_LANGCHAIN_CHAT=true (no frontend flag required).
# USE_LANGCHAIN_CHAT=false
#
# --- LangSmith tracing (LANGCHAIN_TRACING_V2) — OPTIONAL ---
# Shipped runs when USE_LANGCHAIN_CHAT or LangGraph/LangChain code paths record traces.
#
# 1. Create an API key: https://smith.langchain.com/settings → API Keys
# 2. In this file (your real `.env`), set BOTH:
#    LANGCHAIN_TRACING_V2=true
#    LANGCHAIN_API_KEY=lsv2_pt_...   # paste the key from LangSmith (do not commit real keys)
#    (LANGSMITH_API_KEY=... also works; either name is enough.)
#
# 3. Optional — organize runs in the LangSmith UI:
#    LANGCHAIN_PROJECT=my-camera-assistant
#
# If tracing is "true" but the key is missing, the app turns tracing off automatically (avoids 401 log spam).
# If the key is wrong or expired, you still get 401 — fix the key or set LANGCHAIN_TRACING_V2=false.
# Docker: keep these variables in `.env`; `docker-compose` already loads `env_file: .env` for the API container.
#
# Template (use in your real `.env`): tracing is off until you set true and paste a real API key from LangSmith.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=

# --- Assistant: modality routing + optional web grounding ---
# Heuristic router is instant; if top-two modality scores are closer than this margin, a tiny LLM JSON router runs once.
# ROUTER_HEURISTIC_TRUST_MARGIN=1.65
# Skip the LLM router entirely (fastest; heuristics only from the server mirror of the UI rules)
# ROUTER_SKIP_LLM=false
# ROUTER_NUM_PREDICT=120
# ROUTER_TEMPERATURE=0.06
# LLM intent routing is ON by default (natural phrasing). Set ROUTER_LLM_FIRST=false to skip that extra router call.
# ROUTER_LLM_FIRST=false
# Smaller / cheaper model for routing only (defaults to OLLAMA_MODEL)
# OLLAMA_ROUTER_MODEL=
# ASSISTANT_WEB_SEARCH=off

# When the UI sends web_grounding=true (Modality A), the server runs a live web search for the **latest user message**
# and prepends snippets to the system prompt — same path for raw chat and LangChain (LangChain gets a search tool only if prefetch had no results).
# Set WEB_SEARCH_HEURISTIC_ONLY=true to skip that server prefetch (LangChain search_web tool only, when USE_LANGCHAIN_CHAT is on).
# WEB_SEARCH_HEURISTIC_ONLY=false

# Tavily Search (recommended) — API key equals the Tavily dashboard / Remote MCP URL token.
# Strongly recommended for local “nearest / closest / nearby” answers: the server adds your GPS to the search query so snippets list real POIs.
# Remote MCP URL pattern (Cursor, etc.): https://mcp.tavily.com/mcp/?tavilyApiKey=<YOUR_KEY>
# This demo app calls POST https://api.tavily.com/search (same account; not MCP inside FastAPI).
TAVILY_API_KEY=

# Tavily search depth: basic | advanced | fast | ultra-fast (default fast for lower latency)
# TAVILY_SEARCH_DEPTH=fast

# Tavily short answer injected above sources: basic | advanced | true | false | off
# TAVILY_INCLUDE_ANSWER=basic

# After empty Tavily result, optionally fall back to local ddgs (usually lower quality).
# TAVILY_FALLBACK_DDGS=false

# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_MAX_CHARS=5500

# --- Geoapify (optional; reverse lat/lon → address). Do not commit API keys.
# With GEOAPIFY_API_KEY set, reverse geocoding tries Geoapify before Photon (unless REVERSE_GEO_PROVIDER=nominatim).
# GEOAPIFY_API_KEY=
# REVERSE_GEO_PROVIDER=photon
# Force Geoapify only (fail closed unless Photon fallback on): REVERSE_GEO_PROVIDER=geoapify
# After Geoapify failure, fall back to Photon (default on). To disable: REVERSE_GEO_FALLBACK_PHOTON=false
# GEOAPIFY_LANG=en
# GEOAPIFY_REVERSE_LIMIT=1

# --- Reverse geocoding (city / street names from GPS) ---
# Default: Photon (Komoot public API) — no API key or email. OSM-derived data.
# REVERSE_GEO_PROVIDER=photon
# Optional self-hosted Photon base URL (no trailing slash)
# PHOTON_BASE_URL=https://photon.komoot.io
# PHOTON_LANG=en
# PHOTON_USER_AGENT=camera-blind-assist/1.0
# REVERSE_GEO_CACHE_SECS=3600

# Optional: use OSM Nominatim instead (stricter User-Agent / contact policy)
# REVERSE_GEO_PROVIDER=nominatim
# If Photon fails, fall back to Nominatim (set contact email for production use)
# REVERSE_GEO_FALLBACK_NOMINATIM=false
# NOMINATIM_CONTACT_EMAIL=you@example.com
# NOMINATIM_USER_AGENT=my-app/1.0 (contact@example.com)
# NOMINATIM_ACCEPT_LANGUAGE=en
# NOMINATIM_CACHE_SECS=3600

# --- Google Maps Platform (optional; key stays on the server) ---
# Enable Routes API, Geocoding API, Places API (New), Weather API, Geolocation API in Cloud Console
# and restrict the key (HTTP referrer for frontend if any; IP for backend in production).
# GOOGLE_MAPS_API_KEY=
# When true: chat grounding prefers Google Geocoding + Weather; falls back to Photon/Open-Meteo if a call fails or returns empty.
# GOOGLE_MAPS_PLATFORM_ENABLED=false
#
# Chat grounding: auto-fetch Places by intent (generic English phrases → Place types; no venue names in code).
# Override with JSON array of {"pattern": "regex", "types": ["shopping_mall"]}; use [] to disable. Or set:
# GOOGLE_MAPS_GROUNDING_INTENT_NEARBY_OFF=true
#
# Optional: regex override for when to attach pre-fetched walking/transit steps (default: take me / guide me / directions…).
# GOOGLE_MAPS_GROUNDING_INTENT_NAV_REGEX=
# Try TRANSIT before WALK when server prefetches directions into chat grounding (disable if Routes transit not billing-enabled).
# GOOGLE_MAPS_INTENT_PREFETCH_TRANSIT=true
# Optional localization bias (omit both to let Google use its defaults):
# GOOGLE_MAPS_REGION_CODE=AT
# GOOGLE_MAPS_LANGUAGE_CODE=de
#
# Nearby POI block in chat (Places searchNearby). If GOOGLE_MAPS_NEARBY_INCLUDED_TYPES is empty, nearby search is skipped entirely.
# GOOGLE_MAPS_CHAT_NEARBY=true
# GOOGLE_MAPS_NEARBY_RADIUS_M=120
# GOOGLE_MAPS_NEARBY_MAX_RESULTS=10
# GOOGLE_MAPS_NEARBY_MARKDOWN_MAX_ITEMS=12
# Radius (m) for LangChain tool google_maps_nearby_pois (on-demand “nearest X”); Places API max 50_000.
# GOOGLE_MAPS_TOOL_NEARBY_RADIUS_M=2000
# Comma-separated Place types (max 10 sent to Google): https://developers.google.com/maps/documentation/places/web-service/place-types
# GOOGLE_MAPS_NEARBY_INCLUDED_TYPES=bus_stop,train_station,atm,bank,cafe,restaurant,park,tourist_attraction
#
# Optional: override response field masks / endpoints (defaults match Google documentation).
# GOOGLE_MAPS_PLACES_FIELD_MASK=places.displayName,places.formattedAddress,places.location,places.primaryType,places.types,places.shortFormattedAddress,places.googleMapsUri,places.accessibilityOptions
# If you override GOOGLE_MAPS_ROUTES_FIELD_MASK, keep routes.polyline.encodedPolyline and routes.legs.steps.startLocation / endLocation for live walk assist in the web UI.
# GOOGLE_MAPS_ROUTES_FIELD_MASK=routes.duration,routes.distanceMeters,routes.polyline.encodedPolyline,routes.legs.steps.navigationInstruction,routes.legs.steps.localizedValues,routes.legs.steps.travelMode,routes.legs.steps.startLocation,routes.legs.steps.endLocation,routes.legs.steps.transitDetails
# GOOGLE_MAPS_GEOCODE_URL=https://maps.googleapis.com/maps/api/geocode/json
# GOOGLE_MAPS_ROUTES_COMPUTE_URL=https://routes.googleapis.com/directions/v2:computeRoutes
#
# If Cloud Console shows Routes API **100% errors** but the API is “Enabled”, almost always: (1) **Billing**
# not linked to the project; (2) API key **API restrictions** omit **Routes API**; (3) **Application
# restrictions** = HTTP referrers / Android / iOS (wrong for a backend — use **IP** of your server or **None**).
# Check APIs & Services → Credentials → your key, and the error message in API response / backend logs.
# GOOGLE_MAPS_PLACES_SEARCH_NEARBY_URL=https://places.googleapis.com/v1/places:searchNearby
# GOOGLE_MAPS_WEATHER_CURRENT_URL=https://weather.googleapis.com/v1/currentConditions:lookup
# GOOGLE_MAPS_GEOLOCATE_URL=https://www.googleapis.com/geolocation/v1/geolocate
#
# GOOGLE_MAPS_HTTP_TIMEOUT_SEC=25
# GOOGLE_MAPS_ROUTES_HTTP_TIMEOUT_SEC=40
# GOOGLE_MAPS_WAYPOINT_ADDRESS_MAX_LEN=500
#
# Weather units: METRIC | IMPERIAL
# GOOGLE_MAPS_WEATHER_UNITS=METRIC
#
# Quick check: GET /api/maps/status  →  { "enabled": bool, "key_configured": bool }
# POST endpoints (JSON; keep key on server only):
#   POST /api/maps/reverse-geocode   { "latitude", "longitude", "language"?: optional }
#   POST /api/maps/geocode           { "address", "language"?, "region"? }
#   POST /api/maps/weather           { "latitude", "longitude" }
#   POST /api/maps/nearby            { "latitude", "longitude" }
#   POST /api/maps/routes/compute    { "origin", "destination", "travel_mode", "language_code"?, "region_code"?, ... }
#   POST /api/maps/geolocation       optional { "wifiAccessPoints": [...], "cellTowers": [...] }
#
# Glasses (camera + mic + speaker) send one turn as multipart form:
#   POST /api/device/turn
#   fields: text, latitude?, longitude?, location_accuracy_m?, files? (JPEG frames)
#   header when locked: Authorization: Bearer <SEEINGAEYE_APP_PASSWORD>
#   response: { "reply", "modality", "speak": true } — play reply on the glasses speaker.
